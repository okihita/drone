# ==============================================================================
# DRONE — Public Environment Variable Template
# Copy this file to .env.local and fill in the values for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Airtable Headless CMS (Curated Links, Policies, News, Jurisdictions)
# ------------------------------------------------------------------------------
AIRTABLE_PAT=pat...
AIRTABLE_BASE_ID=app...
# Optional custom table name overrides:
# AIRTABLE_TABLE_NAME="Curated Links"
# AIRTABLE_POLICIES_TABLE="Policies"
# AIRTABLE_NEWS_TABLE="News"
# AIRTABLE_JURISDICTIONS_TABLE="Jurisdictions"

# ------------------------------------------------------------------------------
# 2. Automated Pipeline & LLM Classification (Optional)
# ------------------------------------------------------------------------------
CRON_SECRET=your-secure-cron-bearer-token
GEMINI_API_KEY=your-gemini-api-key
